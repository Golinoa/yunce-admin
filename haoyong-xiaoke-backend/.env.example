# ============================================
# 服务器配置
# ============================================
PORT=3000
NODE_ENV=development
SERVER_PUBLIC_ORIGIN=http://localhost:3000
ENABLE_API_DOCS=true

# ============================================
# 数据库配置
# ============================================
DATABASE_URL=mysql://xiaoke:change_me_local_db_password@localhost:3306/xiaoke

# ============================================
# JWT 配置
# ============================================
JWT_SECRET=change_me_local_jwt_secret_min_32_chars
JWT_EXPIRES_IN=2h
JWT_REFRESH_EXPIRES_IN=7d

# ============================================
# 管理后台默认账号（本地开发初始化用）
# ============================================
ADMIN_INIT_USERNAME=admin
ADMIN_INIT_PASSWORD=Admin123456

# ============================================
# 文件上传配置
# ============================================
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
CORS_ORIGINS=http://localhost:10086,http://localhost:3000

# ============================================
# SSL 证书配置（生产环境）
# ============================================
SSL_ENABLED=true
SSL_CERT_PATH=/etc/nginx/ssl
SSL_DOMAIN=api.youche.com
# 用于存放 SSL 证书的七牛云 Bucket（可选）
QINIU_SSL_CERT_BUCKET=your-cert-bucket

# ============================================
# 七牛云对象存储配置（可选）
# ============================================
# 七牛云 AccessKey（从 https://portal.qiniu.com/user/key 获取）
QINIU_ACCESS_KEY=your_qiniu_access_key
# 七牛云 SecretKey
QINIU_SECRET_KEY=your_qiniu_secret_key
# 存储空间名称
QINIU_BUCKET=your_bucket_name
# 存储区域：0=华东, 1=华北, 2=华南, na0=北美
QINIU_REGION=0
# 七牛云默认域名（创建存储空间后可在空间设置中查看）
QINIU_DOMAIN=qvixr6g6.hd-bkt.clouddn.com
# 自定义域名（可选，如已配置 CDN）
# QINIU_CUSTOM_DOMAIN=cdn.yourdomain.com
# 文件路径前缀
QINIU_PREFIX=uploads/
# 是否私有空间：true/false
QINIU_IS_PRIVATE=false

# ============================================
# 微信小程序配置（Mock 用）
# ============================================
WECHAT_APP_ID=your_wechat_app_id
WECHAT_APP_SECRET=your_wechat_app_secret

# ============================================
# 日志配置
# ============================================
LOG_LEVEL=info
