VITE_BASE=/

# 接口地址
VITE_GLOB_API_URL=/api/admin/v1

# 是否开启压缩，可以设置为 none, brotli, gzip
VITE_COMPRESS=gzip

# 是否开启 PWA
VITE_PWA=false

# vue-router 的模式
VITE_ROUTER_HISTORY=hash

# 是否注入全局loading
VITE_INJECT_APP_LOADING=true

# 是否开启 Nitro Mock服务
VITE_NITRO_MOCK=false

# 打包后是否生成 dist.zip（Docker 部署不需要）
VITE_ARCHIVER=false
