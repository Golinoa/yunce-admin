# 应用标题
VITE_APP_TITLE=松果排课运营管理后台

# 应用命名空间（缓存 / store 前缀）
VITE_APP_NAMESPACE=songguo-admin

# 本地开发占位密钥（DEV 可用占位；生产构建禁止占位）
VITE_APP_STORE_SECURE_KEY=please-replace-me-with-your-own-key

# --- production / Docker 额外变量（参考 .env.production）---
# VITE_BASE=/
# VITE_GLOB_API_URL=/api/admin/v1
# VITE_DASHBOARD_VERSION=1.0.4
# 生产密钥请用 Docker build-arg / CI Secret：VITE_APP_STORE_SECURE_KEY
