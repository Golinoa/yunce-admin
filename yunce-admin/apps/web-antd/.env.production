# 应用标题 / 命名空间：必须写在本文件（Docker 不包含未入库的 .env）
# 缺省会导致生产 HTML 残留 %VITE_APP_TITLE%、namespace=undefined、loading 无法卸下
VITE_APP_TITLE=松果排课运营管理后台
VITE_APP_NAMESPACE=songguo-admin

VITE_BASE=/

# 接口地址
VITE_GLOB_API_URL=/api/admin/v1

# store 持久化 AES 密钥：仓库仅保留占位；Docker/CI 必须通过 build-arg 注入真实值
# （占位值会在生产构建启动时失败，见 @vben/stores initStores）
VITE_APP_STORE_SECURE_KEY=please-replace-me-with-your-own-key

# 运营后台发版号（与 git tag v* 对齐；Docker 构建仍以 tag 注入为准）
VITE_DASHBOARD_VERSION=1.0.18

# 是否开启压缩，可以设置为 none, brotli, gzip
VITE_COMPRESS=gzip

# 是否开启 PWA
VITE_PWA=false

# vue-router 的模式（history + 容器 nginx try_files）
VITE_ROUTER_HISTORY=history

# 是否注入全局loading
VITE_INJECT_APP_LOADING=true

# 是否开启 Nitro Mock服务
VITE_NITRO_MOCK=false

# 打包后是否生成 dist.zip（Docker 部署不需要）
VITE_ARCHIVER=false
