generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ==================== 枚举定义 ====================

enum Role {
  PRINCIPAL
  TEACHER
  PARENT
}

enum Gender {
  MALE
  FEMALE
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  GRADUATED
}

enum BindStatus {
  PENDING
  BOUND
  REJECTED
}

enum PackageStatus {
  ACTIVE
  EXPIRED
  DEPLETED
}

enum LessonStatus {
  NORMAL
  CANCELLED
  MAKEUP
}

enum ClassStatus {
  ACTIVE
  DISBANDED
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationType {
  SYSTEM
  LEAVE
  SCHEDULE
  CHECKIN
  HOMEWORK
}

enum FeedbackType {
  BUG
  FEATURE
  OTHER
}

enum FeedbackHandleStatus {
  PENDING
  PROCESSING
  RESOLVED
  CLOSED
}

enum AdminRole {
  ADMIN
}

enum AdminStatus {
  ACTIVE
  DISABLED
}

enum ActivationCodeStatus {
  UNUSED
  USED
  EXPIRED
  VOIDED
}

enum MembershipStatus {
  ACTIVE
  EXPIRED
}

enum MembershipSource {
  ACTIVATION_CODE
  MANUAL
  POINT_EXCHANGE
}

enum PointType {
  EARN
  SPEND
}

enum PointChangeSource {
  INVITE_REWARD
  MANUAL_ADJUST
  POINT_EXCHANGE
  BONUS
}

enum BannerStatus {
  ACTIVE
  INACTIVE
}

enum ActivityStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ENDED
}

// ==================== 核心表 ====================

model Profile {
  id        String   @id @default(uuid())
  unionId   String?  @unique
  openId    String?  @unique
  avatar    String?
  nickname  String?
  name      String?
  phone     String?  @unique
  email     String?
  role      Role     @default(TEACHER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teacher              Teacher?
  parent               StudentParent?
  sentNotifications    Notification[] @relation("Sender")
  receivedNotifications Notification[] @relation("Receiver")
  feedbacks            Feedback[]
  pointAccount         PointAccount?
  pointRecords         PointRecord[]
  membershipGrants     MembershipGrant[]
  sentInvites          InviteRelation[] @relation("Inviter")
  receivedInvite       InviteRelation?  @relation("Invitee")
  redeemedActivationCodes ActivationCode[] @relation("ActivationCodeRedeemer")
}

model AdminUser {
  id           String      @id @default(uuid())
  username     String      @unique
  passwordHash String
  nickname     String?
  role         AdminRole   @default(ADMIN)
  status       AdminStatus @default(ACTIVE)
  lastLoginAt  DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  sessions       AdminSession[]
  auditLogs      AdminAuditLog[]
  pointRecords   PointRecord[]
  membershipLogs MembershipGrant[] @relation("MembershipGrantedByAdmin")
  banners        Banner[]
  activities     Activity[]
  handledFeedbacks Feedback[]

  @@index([status])
}

model AdminSession {
  id             String    @id @default(uuid())
  adminUserId    String
  refreshTokenJti String   @unique
  sessionVersion Int       @default(1)
  expiresAt      DateTime
  revokedAt      DateTime?
  lastUsedAt     DateTime  @default(now())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  adminUser      AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
  @@index([expiresAt])
}

model AdminAuditLog {
  id          String    @id @default(uuid())
  adminUserId String
  action      String
  module      String
  targetId    String?
  detail      String?
  ip          String?
  createdAt   DateTime  @default(now())

  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
  @@index([module])
  @@index([createdAt])
}

model Teacher {
  id          String   @id @default(uuid())
  profileId   String   @unique
  inviteCode  String   @unique @default(uuid())
  institution String?
  // 教师管理扩展字段
  role        String   @default("lead")    // lead(主讲) | assist(助教) | parttime(兼职)
  subject     String?                      // 科目
  color       String   @default("#5EC8A8") // UI 显示颜色
  status      String   @default("active")  // active(在职) | resigned(离职)
  campusId    String?                      // 所属校区
  salaryModelId String?                     // 关联薪资模型
  resignType  String?                       // quit(主动离职) | expire(合同到期) | dismiss(辞退)
  resignDate  DateTime?
  resignReason String?
  payRemark   String?                       // 发薪备注
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  profile            Profile           @relation(fields: [profileId], references: [id], onDelete: Cascade)
  campus             Campus?           @relation(fields: [campusId], references: [id])
  salaryModel        SalaryModel?      @relation(fields: [salaryModelId], references: [id])
  students           Student[]
  classes            Class[]
  schedules          Schedule[]
  coursePackages     CoursePackage[]
  salaryRecords      SalaryRecord[]
  deductions         Deduction[]
  followRecords      FollowRecord[]
  attendances        Attendance[]

  @@index([status])
  @@index([role])
  @@index([campusId])
}

model Student {
  id        String        @id @default(uuid())
  teacherId String
  teacher   Teacher       @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  name      String
  avatar    String?
  nickname  String?
  gender    Gender?
  birthday  DateTime?
  phone     String?
  address   String?
  remark    String?
  inviteCode String?      @unique
  feeAmount Int?          // 费用金额，单位：分
  feeMethod String?
  status    StudentStatus @default(ACTIVE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  parents        StudentParent[]
  classStudents  ClassStudent[]
  lessonRecords  LessonRecord[]
  coursePackages CoursePackage[]
  leaveRequests  LeaveRequest[]
  memberCards    MemberCard[]
  followRecords FollowRecord[]

  @@index([teacherId])
  @@index([status])
}

model StudentParent {
  id         String     @id @default(uuid())
  profileId  String?    @unique
  profile    Profile?   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  studentId  String?
  student    Student?   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  relation   String?
  bindStatus BindStatus @default(PENDING)
  createdAt  DateTime   @default(now())

  @@unique([studentId, profileId])
}

model CoursePackage {
  id          String        @id @default(uuid())
  teacherId   String
  teacher     Teacher       @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  studentId   String
  student     Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  name        String
  type        String?       @default("hour_package")
  totalHours  Int
  usedHours   Int           @default(0)
  giftHours   Int           @default(0)
  validStart  DateTime?
  validEnd    DateTime?
  validDays   Int?
  status      PackageStatus @default(ACTIVE)
  feeAmount   Int?          // 费用金额，单位：分
  feeMethod   String?
  note        String?
  subjectId   String?
  templateId  String?
  installmentEnabled Boolean? @default(false)
  installmentPeriod  Int?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  lessonRecords LessonRecord[]
  recharges     Recharge[]
  installments  InstallmentSchedule[]

  @@index([studentId])
  @@index([teacherId])
  @@index([status])
  @@index([studentId, status])
}

model LessonRecord {
  id         String        @id @default(uuid())
  teacherId  String
  studentId  String
  student    Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  packageId  String?
  package    CoursePackage? @relation(fields: [packageId], references: [id])
  classId    String?
  class      Class?        @relation(fields: [classId], references: [id])
  scheduleId String?
  schedule   Schedule?     @relation(fields: [scheduleId], references: [id])
  lessonDate DateTime
  duration   Int
  hoursUsed  Int?
  content    String?
  homework   String?
  performance String?
  homeworkImages Json?
  feeAmount  Int?          // 费用金额，单位：分
  feeMethod  String?
  status     LessonStatus  @default(NORMAL)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([studentId])
  @@index([teacherId])
  @@index([classId])
  @@index([lessonDate])
  @@index([status])
  @@index([teacherId, lessonDate])
  @@index([teacherId, status, lessonDate])
}

model Class {
  id        String      @id @default(uuid())
  teacherId String
  teacher   Teacher     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  name      String
  subject   String?
  grade     String?
  schedule  String?
  location  String?
  type      String      @default("unlimited")
  teachMode String?
  note      String?
  weekdays  Json?
  startTime String?
  endTime   String?
  totalLessons Int?
  usedLessons Int       @default(0)
  teachers  Json?
  color     String      @default("primary")
  status    ClassStatus @default(ACTIVE)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  students      ClassStudent[]
  lessonRecords LessonRecord[]
  schedules     Schedule[]

  @@index([teacherId])
  @@index([status])
}

model ClassStudent {
  id        String   @id @default(uuid())
  classId   String
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  joinedAt  DateTime @default(now())

  @@unique([classId, studentId])
}

model Schedule {
  id        String   @id @default(uuid())
  teacherId String
  teacher   Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  classId   String?
  class     Class?   @relation(fields: [classId], references: [id], onDelete: SetNull)
  studentId String?
  dayOfWeek Int
  startTime String
  endTime   String
  startDate DateTime?
  endDate   DateTime?
  color     String?
  note      String?
  reminderMinutes Int?
  room      String?
  tag       String?
  courseType String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  lessonRecords LessonRecord[]

  @@index([teacherId])
  @@index([classId])
  @@index([dayOfWeek])
  @@index([teacherId, dayOfWeek])
}

model LeaveRequest {
  id           String      @id @default(uuid())
  studentId    String
  student      Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  parentId     String?
  teacherId    String?
  type         String      @default("leave")
  startDate    DateTime
  endDate      DateTime
  originalDate DateTime?
  newDate      DateTime?
  reason       String
  status       LeaveStatus @default(PENDING)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([studentId])
  @@index([status])
  @@index([teacherId, status])
}

model Notification {
  id         String           @id @default(uuid())
  senderId   String
  sender     Profile          @relation("Sender", fields: [senderId], references: [id])
  receiverId String
  receiver   Profile          @relation("Receiver", fields: [receiverId], references: [id])
  type       NotificationType
  title      String
  content    String
  relatedId  String?
  read       Boolean          @default(false)
  createdAt  DateTime         @default(now())

  @@index([receiverId, read])
  @@index([receiverId, read, createdAt])
}

model Feedback {
  id               String               @id @default(uuid())
  profileId        String
  profile          Profile              @relation(fields: [profileId], references: [id], onDelete: Cascade)
  type             FeedbackType
  content          String
  images           Json?
  role             String?
  contact          String?
  handleStatus     FeedbackHandleStatus @default(PENDING)
  handleRemark     String?
  handledAt        DateTime?
  handledByAdminId String?
  handledByAdmin   AdminUser?           @relation(fields: [handledByAdminId], references: [id], onDelete: SetNull)
  createdAt        DateTime             @default(now())

  @@index([profileId])
  @@index([type])
  @@index([handleStatus])
  @@index([handledByAdminId])
}

// ==================== 新增模型 ====================

model Campus {
  id            String   @id @default(uuid())
  name          String
  type          String   @default("self")
  partnerMode   String?
  phone         String?
  address       String?
  icon          String   @default("🏫")
  iconGradient  String   @default("from-blue-400 to-blue-600")
  isMain        Boolean  @default(false)
  monthlyRent   Int      @default(0)
  rentDueDay    Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  teachers      Teacher[]
}

model Subject {
  id           String   @id @default(uuid())
  name         String
  icon         String   @default("📚")
  color        String   @default("#5EC8A8")
  iconGradient String   @default("from-green-400 to-green-600")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model CoursePackageTemplate {
  id          String   @id @default(uuid())
  teacherId   String
  name        String
  type        String   @default("hour_package")
  price       Int      // 价格，单位：分
  lessonCount Int
  duration    Int      @default(45)
  validDays   Int?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([teacherId])
}

model SalaryModel {
  id         String   @id @default(uuid())
  name       String
  type       String   @default("standard")
  base       Int      @default(0)  // 底薪，单位：分
  rate       Int      @default(0)  // 课时费，单位：分
  attend     Int      @default(0)  // 考勤奖，单位：分
  perf       Int      @default(0)  // 绩效奖，单位：分
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  teachers   Teacher[]
}

model SalaryRecord {
  id         String    @id @default(uuid())
  teacherId  String
  month      String
  amount     Int       // 工资金额，单位：分
  status     String    @default("pending")
  remark     String?
  paidAt     DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  teacher    Teacher   @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([teacherId, month])
  @@index([teacherId, month])
  @@index([status])
}

model Deduction {
  id        String   @id @default(uuid())
  teacherId String
  reason    String
  amount    Int      // 扣款金额，单位：分
  type      String   @default("deduct")
  createdAt DateTime @default(now())

  teacher   Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([teacherId])
}

model Holiday {
  id        String   @id @default(uuid())
  name      String
  icon      String   @default("🎉")
  startDate DateTime
  endDate   DateTime
  type      String   @default("custom")   // legal=法定节假日, custom=自定义
  status    String   @default("rest")     // rest=休息, work=调休上班
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([startDate, endDate])
}

model NotifySetting {
  id        String   @id @default(uuid())
  label     String
  sub       String?
  enabled   Boolean  @default(true)
  group     String   @default("default")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Recharge {
  id         String   @id @default(uuid())
  packageId  String
  package    CoursePackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  amount     Int      // 充值课时数
  method     String?
  createdAt  DateTime @default(now())

  @@index([packageId])
}

model InstallmentSchedule {
  id        String   @id @default(uuid())
  packageId String
  package   CoursePackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  period    Int
  amount    Int      // 分期金额，单位：分
  dueDate   DateTime
  reminder  Boolean  @default(false)
  paid      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([packageId])
}

// 审计日志
model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  userRole  String   // TEACHER / PRINCIPAL
  action    String   // CREATE / UPDATE / DELETE / PAY / UNPAY
  module    String   // student / coursePackage / installment / ...
  targetId  String?  // 操作对象的 ID
  detail    String?  // 操作详情（JSON 字符串）
  ip        String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([module])
  @@index([createdAt])
}

// 预警记录
model Alert {
  id         String   @id @default(uuid())
  teacherId  String
  type       String   // package_expiring / low_hours / pending_leave / pending_salary / overdue_installment
  level      String   @default("warning")  // warning / danger
  title      String
  detail     String
  targetId   String?  // 关联业务对象 ID
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([teacherId])
  @@index([type])
  @@index([isRead])
  @@index([createdAt])
}

// 洞察记录
model Insight {
  id         String   @id @default(uuid())
  teacherId  String
  type       String   // lesson_trend / student_growth / active_packages / income_trend / pending_installment
  title      String
  detail     String
  metric     Int?     // 指标值，金额单位：分
  trend      String?  // up / down / stable
  createdAt  DateTime @default(now())

  @@index([teacherId])
  @@index([type])
  @@index([createdAt])
}

// 认证会话记录
model AuthSession {
  id               String   @id @default(uuid())
  profileId        String
  refreshTokenJti  String   @unique
  sessionVersion   Int      @default(1)
  expiresAt        DateTime
  revokedAt        DateTime?
  lastUsedAt       DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([profileId])
  @@index([refreshTokenJti])
  @@index([expiresAt])
}

// 短信验证码
model SmsVerificationCode {
  id            String   @id @default(uuid())
  phone         String
  codeHash      String
  expiresAt     DateTime
  consumedAt    DateTime?
  failedAttempts Int     @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([phone])
  @@index([expiresAt])
}

// 固定窗口限流桶
model RateLimitBucket {
  id          String   @id @default(uuid())
  scope       String
  key         String
  windowStart DateTime
  expiresAt   DateTime
  count       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([scope, key, windowStart])
  @@index([expiresAt])
  @@index([scope, key, expiresAt])
}

model MembershipPlan {
  id          String   @id @default(uuid())
  name        String
  durationDays Int
  pointsCost  Int      @default(0)
  isActive    Boolean  @default(true)
  remark      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  activationCodes ActivationCode[]
  membershipGrants MembershipGrant[]

  @@index([isActive])
}

model ActivationCode {
  id                 String               @id @default(uuid())
  code               String               @unique
  planId             String
  status             ActivationCodeStatus @default(UNUSED)
  expiresAt          DateTime?
  usedAt             DateTime?
  usedByProfileId    String?
  batchNo            String?
  channel            String?
  remark             String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  plan               MembershipPlan       @relation(fields: [planId], references: [id], onDelete: Cascade)
  usedBy             Profile?             @relation("ActivationCodeRedeemer", fields: [usedByProfileId], references: [id], onDelete: SetNull)
  membershipGrants   MembershipGrant[]

  @@index([planId])
  @@index([status])
  @@index([usedByProfileId])
  @@index([batchNo])
}

model MembershipGrant {
  id                 String           @id @default(uuid())
  profileId          String
  planId             String?
  source             MembershipSource
  status             MembershipStatus @default(ACTIVE)
  startAt            DateTime
  endAt              DateTime
  activationCodeId   String?
  grantedByAdminId   String?
  remark             String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  profile            Profile          @relation(fields: [profileId], references: [id], onDelete: Cascade)
  plan               MembershipPlan?  @relation(fields: [planId], references: [id], onDelete: SetNull)
  activationCode     ActivationCode?  @relation(fields: [activationCodeId], references: [id], onDelete: SetNull)
  grantedByAdmin     AdminUser?       @relation("MembershipGrantedByAdmin", fields: [grantedByAdminId], references: [id], onDelete: SetNull)

  @@index([profileId, status])
  @@index([endAt])
  @@index([activationCodeId])
}

model InviteRelation {
  id               String   @id @default(uuid())
  inviterProfileId String
  inviteeProfileId String   @unique
  source           String?  @default("share")
  createdAt        DateTime @default(now())

  inviter          Profile  @relation("Inviter", fields: [inviterProfileId], references: [id], onDelete: Cascade)
  invitee          Profile  @relation("Invitee", fields: [inviteeProfileId], references: [id], onDelete: Cascade)

  @@unique([inviterProfileId, inviteeProfileId])
  @@index([inviterProfileId])
}

model InviteTaskRule {
  id                 String   @id @default(uuid())
  taskKey            String   @unique
  name               String
  pointsReward       Int
  inviteePointsReward Int     @default(0)
  enabled            Boolean  @default(true)
  remark             String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([enabled])
}

model PointAccount {
  id         String   @id @default(uuid())
  profileId  String   @unique
  balance    Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  profile    Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model PointRecord {
  id              String            @id @default(uuid())
  profileId       String
  type            PointType
  amount          Int
  balanceAfter    Int
  source          PointChangeSource
  relatedId       String?
  operatorAdminId String?
  remark          String?
  createdAt       DateTime          @default(now())

  profile         Profile           @relation(fields: [profileId], references: [id], onDelete: Cascade)
  operatorAdmin   AdminUser?        @relation(fields: [operatorAdminId], references: [id], onDelete: SetNull)

  @@index([profileId, createdAt])
  @@index([source])
}

model Banner {
  id            String       @id @default(uuid())
  title         String
  imageUrl      String
  slotKey       String       @default("HOME_BANNER")
  templateKey   String       @default("HOME_BANNER_IMAGE")
  jumpType      String       @default("none")
  jumpValue     String?
  actionConfig  Json?
  displayConfig Json?
  sortOrder     Int          @default(0)
  status        BannerStatus @default(ACTIVE)
  startsAt      DateTime?
  endsAt        DateTime?
  createdById   String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  createdBy     AdminUser?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([status, slotKey, sortOrder])
}

model Activity {
  id            String         @id @default(uuid())
  title         String
  coverImageUrl String?
  summary       String?
  content       String?
  slotKey       String         @default("HOME_POPUP")
  templateKey   String         @default("HOME_POPUP_SINGLE")
  jumpType      String         @default("none")
  jumpValue     String?
  actionConfig  Json?
  displayConfig Json?
  status        ActivityStatus @default(DRAFT)
  startsAt      DateTime?
  endsAt        DateTime?
  sortOrder     Int            @default(0)
  createdById   String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  createdBy     AdminUser?     @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([status, slotKey, sortOrder])
}

// ==================== 场地预约模块 ====================

enum VenueStatus {
  ACTIVE
  INACTIVE
}

enum RoomStatus {
  ACTIVE
  INACTIVE
}

enum VenueSlotStatus {
  ACTIVE
  INACTIVE
}

enum VenueBookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

model Venue {
  id        String       @id @default(uuid())
  campusId  String
  name      String
  address   String?
  status    VenueStatus  @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  rooms    Room[]
  slots    VenueTimeSlot[]
  bookings VenueBooking[]

  @@index([campusId])
  @@index([status])
}

model Room {
  id        String     @id @default(uuid())
  venueId   String
  name      String
  capacity  Int       @default(20)
  status    RoomStatus @default(ACTIVE)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  venue    Venue           @relation(fields: [venueId], references: [id], onDelete: Cascade)
  bookings VenueBooking[]

  @@index([venueId])
  @@index([status])
}

model VenueTimeSlot {
  id        String          @id @default(uuid())
  venueId   String
  dayOfWeek Int             // 1-7 (周一到周日)
  startTime String          // "09:00"
  endTime   String          // "12:00"
  status    VenueSlotStatus @default(ACTIVE)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([venueId])
  @@index([dayOfWeek])
}

model VenueBooking {
  id        String             @id @default(uuid())
  venueId   String
  roomId    String
  date      DateTime           @db.Date
  startTime String
  endTime   String
  purpose   String?
  bookerId  String             // 预约人ID
  status    VenueBookingStatus @default(PENDING)
  remark    String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)
  room  Room  @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([venueId])
  @@index([roomId])
  @@index([date])
  @@index([bookerId])
  @@index([status])
}

// ==================== 卡种与会员卡模块 ====================

enum CardTypeKind {
  count
  time
  stored
}

enum CardTypeStatus {
  active
  inactive
}

enum CardTypeScope {
  course
  venue
}

enum CardTypeCategory {
  formal
  trial
  gift
}

enum MemberCardStatus {
  active
  inactive
  usedUp
  notActivated
  frozen
}

model CardType {
  id                     String           @id @default(uuid())
  name                   String
  kind                   CardTypeKind     @default(count)
  status                 CardTypeStatus   @default(active)
  scopes                 Json             @default("[\"course\"]")   // CardTypeScope[]
  bookingMethod          String           @default("course")         // course | teacher | none
  categoryIds            Json             @default("[]")             // string[]
  count                  Int?             // 次卡次数
  validDays              Int              @default(365)              // 有效天数
  price                  Int              @default(0)               // 售价，单位：分
  freezeCount            Int              @default(0)               // 可冻卡次数
  freezeDays             Int              @default(0)               // 可冻卡天数
  benefits               String?                                           // 权益说明
  cardCategory           CardTypeCategory @default(formal)           // formal | trial | gift
  renewalPrice           Int?                                              // 续卡价
  dailyMaxBookings       Int              @default(0)               // 每日最大约课次数
  weeklyMaxBookings      Int              @default(0)               // 每周最大约课次数
  monthlyMaxBookings    Int              @default(0)               // 每月最大约课次数
  freeCancelCount        Int              @default(0)               // 免责取消次数
  advanceBookingMinutes  Int              @default(0)               // 提前约课分钟数
  availableWeekdays      Json             @default("[]")             // number[]
  onlinePurchase         Boolean          @default(false)            // 支持线上购买
  studentIdentityLimit   Boolean          @default(false)            // 学生身份限制
  isGiftCard             Boolean          @default(false)            // 是否赠卡
  allowTransfer          Boolean          @default(false)            // 允许转卡
  usageLimit             Int              @default(0)               // 使用人数限制
  commissionCalc         String?                                          // 提成计算方式
  backgroundImage         String?                                         // 会员卡底图
  campusIds              Json             @default("[]")             // 适用校区，[]表示不限
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  memberCards MemberCard[]

  @@index([status])
}

model MemberCard {
  id               String            @id @default(uuid())
  cardTypeId       String
  studentId        String
  status           MemberCardStatus  @default(notActivated)
  remainingCount   Int?              // 剩余次数
  purchaseAt       DateTime         @default(now())                 // 购买时间
  activatedAt      DateTime?                                          // 开卡时间
  expiredAt        DateTime?                                         // 到期时间
  frozenCount      Int               @default(0)                   // 已冻卡次数
  frozenDays       Int               @default(0)                   // 已冻卡天数
  purchasePrice    Int               @default(0)                   // 购买价，单位：分
  source           String?                                          // 开卡来源
  operatorId       String?                                         // 操作人ID
  cardNo           String?                                         // 会员卡号
  remark           String?                                         // 备注
  totalGiftCount   Int               @default(0)                   // 赠送总次数
  remainingGiftCount Int              @default(0)                   // 赠送剩余次数
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  cardType  CardType @relation(fields: [cardTypeId], references: [id], onDelete: Cascade)
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([cardTypeId])
  @@index([studentId])
  @@index([status])
}

// ==================== 跟进记录模块 ====================

enum FollowRecordType {
  call
  wechat
  visit
  other
}

enum FollowRecordStatus {
  pending
  completed
}

model FollowRecord {
  id          String            @id @default(uuid())
  studentId   String
  teacherId   String
  type        FollowRecordType  @default(call)
  status      FollowRecordStatus @default(pending)
  content     String
  nextDate    DateTime?         @db.Date
  nextContent String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([teacherId])
  @@index([status])
}

// ==================== 试听线索模块 ====================

model Lead {
  id                    String   @id @default(uuid())
  trialStudentId        String   @unique @default(uuid())
  childName            String
  childNickname        String?
  childGender           String?
  childAge              String?
  parentUserId          String?
  parentName            String?
  parentPhone           String?
  firstInviteTeacherId  String?
  latestInviteTeacherId String?
  bookingTeacherId      String?
  ownerTeacherId        String?
  creatorTeacherId      String
  campusId              String
  sourceType            String   @default("manual")
  sourceCourseId        String?
  bookingCourseId       String?
  sourceChannel         String?
  ownerLockStatus       String   @default("weak")
  ownerLockReason       String?
  status                String   @default("new")
  firstTouchAt         DateTime?
  bookedAt              DateTime?
  convertedAt           DateTime?
  closedReason          String?
  notes                 String?
  duplicateHint         Boolean  @default(false)
  weakBindParent        Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  contacts     LeadContact[]
  followUps    LeadFollowUp[]
  bookings     LeadBooking[]
  conversions  LeadConversion[]

  @@index([creatorTeacherId])
  @@index([ownerTeacherId])
  @@index([campusId])
  @@index([status])
  @@index([parentPhone])
}

model LeadContact {
  id        String   @id @default(uuid())
  leadId    String
  name      String
  relation  String
  phone     String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
}

model LeadFollowUp {
  id              String   @id @default(uuid())
  leadId          String
  action          String
  intentLevel     String?
  content         String
  nextFollowUpAt  DateTime?
  operatorId      String
  createdAt       DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([operatorId])
}

model LeadBooking {
  id                    String   @id @default(uuid())
  leadId                String
  trialStudentId        String
  trialMode             String   @default("group")
  referenceScheduleId   String?
  timeOffsetMinutes     Int?
  classId               String?
  className             String?
  courseId              String
  courseName            String
  subjectId             String?
  subjectName           String?
  campusId              String
  campusName            String?
  teacherId             String
  teacherName           String?
  lessonDate            DateTime @db.Date
  startTime            String
  endTime              String
  room                  String?
  status                String   @default("pending")
  difficulty            String?
  bookingType           String   @default("self")
  operatorId           String?
  note                  String?
  childName             String?
  parentName            String?
  parentPhone           String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([teacherId])
  @@index([lessonDate])
  @@index([status])
}

model LeadConversion {
  id                 String   @id @default(uuid())
  leadId             String
  conversionType      String
  studentId          String
  mergeToStudentId   String?
  operatorId         String
  note               String?
  createdAt          DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([studentId])
}

model TrialSlotConfig {
  id                String   @id @default(uuid())
  courseId          String
  courseName       String
  subjectId         String?
  subjectName       String?
  campusId          String
  campusName        String?
  teacherId         String
  teacherName       String?
  lessonDate        DateTime @db.Date
  startTime        String
  endTime          String
  room              String?
  maxCount         Int      @default(5)
  currentCount     Int      @default(0)
  status           String   @default("active")
  creatorTeacherId String
  note              String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([teacherId])
  @@index([campusId])
  @@index([lessonDate])
  @@index([status])
}

model InviteRecord {
  id           String   @id @default(uuid())
  code         String   @unique
  teacherId    String
  campusId     String
  type         String   @default("trial")
  targetUrl    String?
  scanCount    Int      @default(0)
  convertCount Int      @default(0)
  expiresAt    DateTime?
  createdAt    DateTime @default(now())

  @@index([teacherId])
  @@index([code])
}

// ==================== 考勤模块 ====================

model Attendance {
  id          String   @id @default(uuid())
  teacherId   String
  date        DateTime @db.Date
  status      String   @default("present")  // present | late | absent | leave
  checkInTime DateTime?
  checkOutTime DateTime?
  remark      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([teacherId, date])
  @@index([teacherId])
  @@index([date])
}

// ==================== 薪资模板模块 ====================

model SalaryTemplate {
  id         String   @id @default(uuid())
  campusId   String
  name       String
  baseSalary Int      @default(0)  // 底薪，单位：分
  rules      Json     @default("[]")  // 薪资规则配置
  status     String   @default("active")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([campusId])
}

// ==================== 临时调课模块 ====================

enum RescheduleStatus {
  pending
  approved
  rejected
}

model TemporaryReschedule {
  id           String          @id @default(uuid())
  scheduleId   String
  originalDate DateTime       @db.Date
  originalTime String
  targetDate   DateTime       @db.Date
  targetTime   String
  reason       String
  status       RescheduleStatus @default(pending)
  approvedBy   String?
  approvedAt   DateTime?
  createdBy   String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([scheduleId])
  @@index([status])
}

model BatchReschedule {
  id         String   @id @default(uuid())
  batchNo    String   @unique
  reason     String
  schedules  Json     @default("[]")  // 调课明细
  status     RescheduleStatus @default(pending)
  createdBy  String
  approvedBy String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([batchNo])
  @@index([status])
}
